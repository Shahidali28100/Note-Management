{
  "$comment": "Copy this file to appsettings.Development.json (gitignored) and fill in real local values. DefaultConnection targets a local SQL Server Express instance (.\\SQLEXPRESS), not LocalDB — LocalDB cannot host Full-Text Search (AB-1007 plan.md §0). Install SQL Server Express (not just LocalDB) locally if you don't already have it.",
  "ConnectionStrings": {
    "DefaultConnection": "Server=.\\SQLEXPRESS;Database=NoteManagementDb;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "Jwt": {
    "$comment": "Secret — never commit a real value. Generate a random 256-bit (32+ byte) key for local dev, e.g.: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))",
    "SigningKey": "REPLACE_WITH_A_RANDOM_LOCAL_DEV_SECRET_AT_LEAST_32_BYTES"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  }
}
